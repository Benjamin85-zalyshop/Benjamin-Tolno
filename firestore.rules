rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'benjamintolno7@gmail.com';
    }

    // L'administrateur suprême a accès à tout
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- PORTAIL WEB DES PARENTS (QR CODE) ---
    // Lecture publique autorisée pour le scan du QR Code (Vérification des Bulletins scolaires)
    match /students/{studentId} {
      allow read: if true;
      // Écriture réservée aux écoles authentifiées ou à l'administrateur
      allow write: if request.auth != null;
    }

    match /schools/{schoolId} {

      function isUserInSchool() {
        return request.auth != null && (
          request.auth.token.email == schoolId ||
          exists(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid))
        );
      }

      function isFondateur() {
        return request.auth != null && (
          request.auth.token.email == schoolId ||
          (exists(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.role == 'FONDATEUR')
        );
      }

      // Lecture publique des informations de base de l'école (nom, logo, contact, frais)
      // Indispensable pour le portail web des parents lors du scan QR code et pour la connexion
      allow read: if true;
      // Seuls le fondateur de l'école ou l'administrateur peuvent modifier la configuration de l'école
      allow write: if isFondateur() || isAdmin();

      // Sous-collections privées et sensibles (paiements, dépenses, notes, etc.)
      // Strictement réservées au personnel de CETTE école
      match /{subcollection}/{document=**} {
        allow read, write: if isUserInSchool() || isAdmin();
      }

      match /users/{userId} {
        allow write: if request.auth != null && (request.auth.uid == userId || isFondateur() || isAdmin());
        allow read: if isUserInSchool() || isAdmin();
      }

      // Élèves internes rattachés à une école spécifique
      match /students/{studentId} {
        allow read: if true; // Permet la lecture publique pour la vérification du QR Code
        allow write: if isUserInSchool() || isAdmin(); // Seuls les membres de cette école peuvent inscrire/modifier
      }
    }
  }
}
