rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permettre l'accès aux écoles et sous-collections (élèves, paiements, matières, notes, etc.)
    match /schools/{schoolId} {
      allow read, write: if true;
      
      match /{document=**} {
        allow read, write: if true;
      }
    }
    
    // Données publiques ou synchronisées des élèves (portail web parents & QR codes)
    match /students/{studentId} {
      allow read, write: if true;
    }
  }
}
