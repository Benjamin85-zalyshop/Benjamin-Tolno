rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'benjamintolno7@gmail.com';
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- AJOUT POUR LE PORTAIL WEB DES PARENTS (QR CODE) ---
    // Autorise la lecture de la collection racine "students" pour les bulletins
    match /students/{studentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /schools/{schoolId} {

      // Le créateur du compte (l'email principal) ou un utilisateur enregistré
      function isUserInSchool() {
        return request.auth != null && (
          request.auth.token.email == schoolId ||
          exists(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid))
        );
      }

      // Le créateur du compte (l'email principal) ou un Fondateur enregistré
      function isFondateur() {
        return request.auth != null && (
          request.auth.token.email == schoolId ||
          get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.role == 'FONDATEUR'
        );
      }

      allow read: if isUserInSchool();
      allow write: if isFondateur(); // SEULS LES FONDATEURS PEUVENT MODIFIER LE LOGO/PRIX

      match /{subcollection}/{document=**} {
        allow read, write: if isUserInSchool();
      }

      match /users/{userId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if isUserInSchool();
      }

      // Copie interne de l'école
      match /students/{studentId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
